<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".RandomizerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_light"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Randomizer">
        <activity
            android:name=".NumberActivity"
            android:exported="false" />
        <activity
            android:name=".TeamResultActivity"
            android:exported="false" />
        <activity
            android:name=".TeamSetupActivity"
            android:exported="false" />
        <activity
            android:name=".CategoriesSetupActivity"
            android:exported="false" />
        <activity
            android:name=".CategoriesActivity"
            android:exported="false" />
        <activity
            android:name=".CoinActivity"
            android:exported="false" />
        <activity
            android:name=".DiceActivity"
            android:exported="false" />
        <activity
            android:name=".YatzyActivity"
            android:exported="false" />
        <activity
            android:name=".StartMenu"
            android:exported="false" />
        <!-- Launcher entries, one per icon. LauncherIcon enables the one that matches
             the app theme. They open LaunchActivity, which starts StartMenu in the app's
             own task, so disabling an alias does not close the running app. -->
        <activity
            android:name=".LaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="carl.coding.launch"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity-alias
            android:name=".LauncherLight"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:targetActivity=".LaunchActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:targetActivity=".LaunchActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
